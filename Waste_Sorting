      "metadata": {
        "id": "jjZyTP6pznnu"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def get_batch(dataset, batch_size):\n",
        "\n",
        "  batch = []\n",
        "\n",
        "  for i in range(batch_size):\n",
        "\n",
        "    random_class = random.randint(0, len(classes_list)-1)\n",
        "\n",
        "    class_name = classes_list[random_class]\n",
        "\n",
        "    random_image = random.randint(0, len(dataset[class_name])-1)\n",
        "\n",
        "    batch.append([class_name,\n",
        "                  dataset[class_name][random_image]])\n",
        "\n",
        "  return batch"
      ],
      "metadata": {
        "id": "oepAD1hPznYU"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "**The next function is the training loop where we compute the error over the mini-batch and backpropagate the gradient through the model:**"
      ],
      "metadata": {
        "id": "D0joGa1eLNx-"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Q1yehKQMREeC"
      },
      "outputs": [],
      "source": [
        "def train(model, training_batch, batch_size, optimizer, criterion, device):\n",
        "\n",
        "    loss = 0\n",
        "    acc = 0\n",
        "\n",
        "    for i in range(batch_size):\n",
        "\n",
        "      class_name = training_batch[i][0]\n",
        "      file_name = training_batch[i][1]\n",
        "      img = Image.open('standardized_256/' + class_name + '/' + file_name)\n",
        "      img = np.float32(np.asarray(img)/255)\n",
        "\n",
        "      # Step 2: For noise and transformation, mirror images sideways and\n",
        "      # add bit of Gaussian Noise, only to around 50% of images so its a mix.\n",
        "      if random.uniform(0,1) < 0.5:\n",
        "        img = np.fliplr(img)\n",
        "        img = img.copy()\n",
        "      if random.uniform(0,1) < 0.5:\n",
        "        noise = np.random.normal(0, 0.005, img.shape)\n",
        "        img = img + noise\n",
        "        img = np.clip(img, 0, 1)\n",
        "      if random.uniform(0,1) < 0.5:\n",
        "        brightness = random.uniform(0.8, 1.2)\n",
        "        img = img * brightness\n",
        "        img = np.clip(img, 0, 1)\n",
        "      if random.uniform(0,1) < 0.5:\n",
        "        angle = random.uniform(-15, 15)\n",
        "        img_pil = Image.fromarray((img * 255).astype(np.uint8))\n",
        "        img_pil = img_pil.rotate(angle)\n",
        "        img = np.float32(np.asarray(img_pil) / 255)\n",
        "\n",
        "      data = torch.from_numpy(img)\n",
        "      data = data.permute(2, 0, 1)\n",
        "      data = data.unsqueeze(0)\n",
        "      x = data.float().to(device)\n",
        "\n",
        "      desired_labels = [0.0] * 10\n",
        "      desired_labels[classes_list.index(class_name)] = 1.0\n",
        "      y = torch.tensor(desired_labels, dtype=torch.long, device=device)\n",
        "\n",
        "      y_pred = model.forward(x)\n",
        "      loss += criterion(y_pred, y.unsqueeze(0).float())\n",
        "      acc += calculate_accuracy(y_pred, y.unsqueeze(0).float())\n",
        "\n",
        "    # Get the average loss over the batch\n",
        "    loss /= batch_size\n",
        "    acc /= batch_size\n",
        "\n",
        "    # Backpropagation\n",
        "    optimizer.zero_grad()\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    return loss.item(), acc"
      ]
    },
