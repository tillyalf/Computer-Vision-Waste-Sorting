        "def calculate_accuracy(y_pred, y):\n",
        "\n",
        "    _, index_y = torch.max(y, dim=-1)\n",
        "    _, index_y_pred = torch.max(y_pred, dim=-1)\n",
        "\n",
        "    if index_y == index_y_pred:\n",
        "\n",
        "      acc = 1\n",
        "\n",
        "    else:\n",
        "\n",
        "      acc = 0\n",
        "\n",
        "    return acc"
      ]
