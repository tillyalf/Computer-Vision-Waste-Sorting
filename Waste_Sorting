        "def validation(model, validation_set, batch_size, criterion, device):\n",
        "\n",
        "    epoch_loss = 0\n",
        "    epoch_acc = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for i in range(10):\n",
        "\n",
        "          class_name = validation_set[i][0]\n",
        "          file_name = validation_set[i][1]\n",
        "          img = Image.open('standardized_256/' + class_name + '/' + file_name)\n",
        "          img = np.float32(np.asarray(img)/255)\n",
        "\n",
        "          data = torch.from_numpy(img)\n",
        "          data = data.permute(2, 0, 1)\n",
        "          data = data.unsqueeze(0)\n",
        "          x = data.float().to(device)\n",
        "\n",
        "          desired_labels = [0.0] * 10\n",
        "          desired_labels[classes_list.index(class_name)] = 1.0\n",
        "          y = torch.tensor(desired_labels, dtype=torch.long, device=device)\n",
        "\n",
        "          y_pred = model.forward(x)\n",
        "\n",
        "          epoch_loss += criterion(y_pred, y.unsqueeze(0).float()).item()\n",
        "          epoch_acc += calculate_accuracy(y_pred, y.unsqueeze(0).float())\n",
        "\n",
        "        return epoch_loss / batch_size, epoch_acc / batch_size"
      ]
